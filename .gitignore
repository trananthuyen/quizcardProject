# ==============================================================================
# QuizCard Project - .gitignore
# File cấu hình bỏ qua các tập tin không cần thiết khi đẩy lên GitHub
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. .NET / C# Build & Compiler Outputs
# ------------------------------------------------------------------------------
**/bin/
**/obj/
[Bb]in/
[Oo]bj/
publish/
publish-*/
**/publish/

# Visual Studio & MSBuild temporary files
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
*.docstates
Generated\ Files/
_ReSharper*/
*.DotSettings.user

# ------------------------------------------------------------------------------
# 2. Cơ sở dữ liệu SQLite (Database files & lock/journal files)
# Lưu ý: Database SQLite sẽ được ứng dụng tự động khởi tạo và seed dữ liệu mẫu
# khi khởi chạy ứng dụng (qua DbInitializer.cs). Không nên commit file DB nhị phân.
# ------------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# ------------------------------------------------------------------------------
# 3. Node.js / React Frontend (ClientApp)
# ------------------------------------------------------------------------------
**/node_modules/
node_modules/
**/dist/
**/dist-ssr/
.vite/
.eslintcache

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. Môi trường & Bí mật (Environment & Secrets)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.local
appsettings.*.local.json

# ------------------------------------------------------------------------------
# 5. IDE & Editor files
# ------------------------------------------------------------------------------
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# 6. Operating System files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 7. Thư mục tạm & Scratch scripts
# ------------------------------------------------------------------------------
scratch/
*.tmp

