<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SpaRoot>ClientApp\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
    <UserSecretsId>81c6cd7b-5ae8-449d-92fc-9b085bd83380</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Không đưa mã nguồn ClientApp vào thư mục Publish đầu ra -->
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />

    <!-- Tự động sao chép file cơ sở dữ liệu SQLite vào thư mục publish nếu đã có ở dự án -->
    <None Include="quizcard.db" Condition="Exists('quizcard.db')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\QuizCard.RepositoryContracts\QuizCard.RepositoryContracts.csproj" />
    <ProjectReference Include="..\..\QuizCard.ServiceContracts\QuizCard.ServiceContracts.csproj" />
    <ProjectReference Include="..\QuizCard.Entities\QuizCard.Entities.csproj" />
    <ProjectReference Include="..\QuizCard.Repositories\QuizCard.Repositories.csproj" />
    <ProjectReference Include="..\QuizCard.Services\QuizCard.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\assets\" />
  </ItemGroup>

  <!-- Tự động chạy build Frontend React và đóng gói vào wwwroot khi chạy dotnet publish -->
  <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />

    <ItemGroup>
      <DistFiles Include="$(ProjectDir)wwwroot\**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
